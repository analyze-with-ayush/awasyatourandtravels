<div class="fixed bottom-6 right-5 md:bottom-8 md:right-8 z-[100]">
    <a class="bg-[#163A34] text-white w-14 h-14 rounded-full flex items-center justify-center shadow-2xl hover:scale-110 transition-transform" href="tel:9926547855">
        <span class="material-symbols-outlined text-2xl">phone</span>
    </a>
