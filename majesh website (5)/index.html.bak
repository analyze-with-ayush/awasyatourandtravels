<!-- Booking & Contact Section -->
<section class="py-24 bg-[#FAF7EF]" id="booking">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
            <!-- Form Card -->
            <div class="glass-card p-10 md:p-12 rounded-[3rem] premium-shadow border border-white">
                <h2 class="text-3xl font-extrabold text-[#163A34] mb-8">Book Your Premium Ride</h2>
                <form class="space-y-6" id="bookingForm">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-widest px-1">Full Name</label>
                            <input class="w-full bg-slate-100/50 border-transparent rounded-2xl p-4 focus:ring-2 focus:ring-[#227A65] focus:bg-white transition-all font-medium" id="name" placeholder="Rahul Sharma" required="" type="text"/>
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-widest px-1">Phone Number</label>
                            <input class="w-full bg-slate-100/50 border-transparent rounded-2xl p-4 focus:ring-2 focus:ring-[#227A65] focus:bg-white transition-all font-medium" id="phone" placeholder="99265 47855" required="" type="tel"/>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-widest px-1">Pickup From</label>
                            <input class="w-full bg-slate-100/50 border-transparent rounded-2xl p-4 focus:ring-2 focus:ring-[#227A65] focus:bg-white transition-all font-medium" id="pickup" placeholder="Airport, Home, Office" required="" type="text"/>
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-widest px-1">Destination</label>
                            <input class="w-full bg-slate-100/50 border-transparent rounded-2xl p-4 focus:ring-2 focus:ring-[#227A65] focus:bg-white transition-all font-medium" id="destination" placeholder="Ujjain, Omkareshwar, etc." required="" type="text"/>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-widest px-1">Date</label>
                            <input class="w-full bg-slate-100/50 border-transparent rounded-2xl p-4 focus:ring-2 focus:ring-[#227A65] focus:bg-white transition-all font-medium" id="date" required="" type="date"/>
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-widest px-1">Time</label>
                            <input class="w-full bg-slate-100/50 border-transparent rounded-2xl p-4 focus:ring-2 focus:ring-[#227A65] focus:bg-white transition-all font-medium" id="time" required="" type="time"/>
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-bold text-slate-500 uppercase tracking-widest px-1">Preferred Car</label>
                            <select class="w-full bg-slate-100/50 border-transparent rounded-2xl p-4 focus:ring-2 focus:ring-[#227A65] focus:bg-white transition-all font-medium appearance-none" id="vehicle">
                                <option>Swift Dzire</option>
                                <option>Hyundai Aura</option>
                                <option>Ertiga</option>
                                <option>Innova Crysta</option>
                                <option>Tempo Traveller</option>
                                <option>Force Urbania</option>
                            </select>
                        </div>
                    </div>
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-slate-500 uppercase tracking-widest px-1">Message (Optional)</label>
                        <textarea class="w-full bg-slate-100/50 border-transparent rounded-2xl p-4 focus:ring-2 focus:ring-[#227A65] focus:bg-white transition-all font-medium" id="message" placeholder="Any special requests?" rows="3"></textarea>
                    </div>
                    <button class="w-full bg-[#25D366] text-white py-6 rounded-2xl font-black text-xl flex items-center justify-center gap-4 hover:bg-[#1ebc56] transition-all shadow-xl shadow-green-500/20 active:scale-95" type="submit">
                        <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.538-2.961-2.654-.087-.116-.708-.943-.708-1.798 0-.855.449-1.275.609-1.449.159-.174.347-.217.463-.217l.333.005c.106.005.246-.04.384.293.144.348.491 1.203.535 1.29.044.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.777 1.394.864.174.087.275.072.376-.044.101-.116.434-.506.549-.68.116-.174.231-.145.39-.087s1.013.477 1.186.564c.174.087.289.13.333.203.044.072.044.419-.1.824z"></path></svg>
                        Send on WhatsApp
                    </button>
                </form>
            </div>
            <!-- Map & Contact Info -->
            <div class="space-y-10">
                <div class="rounded-[3rem] overflow-hidden shadow-2xl h-[400px] border border-white">
                    <iframe title="Map of Indore, Bhopal and Ujjain" allowfullscreen="" height="100%" loading="lazy" src="https://www.google.com/maps?q=Indore%2C%20Bhopal%2C%20Ujjain%20Madhya%20Pradesh&output=embed" style="border:0;" width="100%"></iframe>
                </div>
                <div class="grid grid-cols-1 gap-6">
                    <div class="bg-white p-8 rounded-[2.5rem] shadow-lg flex items-center gap-6 min-w-0 group hover:bg-[#227A65] transition-all hover:text-white">
                        <div class="w-16 h-16 rounded-2xl bg-emerald-50 text-[#227A65] flex items-center justify-center shrink-0 group-hover:bg-white/10 group-hover:text-white">
                            <span class="material-symbols-outlined text-3xl">call</span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-xs font-bold uppercase tracking-widest opacity-60">Primary Contact</p>
                            <a class="inline-block text-2xl font-black" href="tel:9926547855">99265 47855</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

