<script>
    function toggleMobileMenu() {
        const menu = document.getElementById('mobileMenu');
        const btn = document.getElementById('mobileMenuBtn');
        if (menu) {
            menu.classList.toggle('hidden');
            if (btn) btn.textContent = menu.classList.contains('hidden') ? 'menu' : 'close';
        }
    }
    function closeMobileMenu() {
        const menu = document.getElementById('mobileMenu');
        const btn = document.getElementById('mobileMenuBtn');
        if (menu) menu.classList.add('hidden');
        if (btn) btn.textContent = 'menu';
    }
    const bookingForm = document.getElementById('bookingForm');
    if (bookingForm) bookingForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const fields = ['name', 'phone', 'pickup', 'destination', 'date', 'time', 'vehicle', 'message'];
        const values = Object.fromEntries(fields.map(id => [id, document.getElementById(id)?.value || '']));
        const whatsappText = [
            'New Booking Request - Awasya Tour and Travels', '',
            `Full Name: ${values.name}`, `Phone Number: ${values.phone}`,
            `Pickup From: ${values.pickup}`, `Destination: ${values.destination}`,
            `Date: ${values.date}`, `Time: ${values.time}`,
            `Preferred Car: ${values.vehicle}`, `Message: ${values.message || 'N/A'}`
        ].join('\n');
        window.open(`https://wa.me/919926547855?text=${encodeURIComponent(whatsappText)}`, '_blank', 'noopener');
    });
</script>

