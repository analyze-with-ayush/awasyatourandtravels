<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>

    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Awasya Tour and Travels | Taxi Service in Indore, Bhopal &amp; Ujjain</title>
    <meta name="description" content="Awasya Tour and Travels offers local taxis, airport transfers, corporate travel, rental cabs and outstation trips in Indore, Bhopal and Ujjain."/>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;family=DM+Serif+Display&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <style>
        :root {
            --primary: #163A34;
            --secondary: #227A65;
            --accent: #D97745;
            --whatsapp: #25D366;
        }
        body { font-family: 'Inter', sans-serif; }
        h1, h2, h3, h4, h5, h6 { font-family: 'DM Serif Display', Georgia, serif; font-weight: 400; }
        
        .glass-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        .glass-dark {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .premium-shadow {
            box-shadow: 0 20px 50px -12px rgba(15, 23, 42, 0.12);
        }
        .hero-gradient {
            background: linear-gradient(to bottom, rgba(15, 23, 42, 0.3) 0%, rgba(15, 23, 42, 0.8) 100%);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        @keyframes fadeInScale {
            from { opacity: 0; transform: scale(0.98); }
            to { opacity: 1; transform: scale(1); }
        }
        
        .nav-link {
            position: relative;
            transition: color 0.3s;
        }
        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -4px;
            left: 0;
            background-color: var(--secondary);
            transition: width 0.3s;
        }
        .nav-link:hover::after { width: 100%; }

                /* Hero Section Scoped Styles & Animations */
        @keyframes heroSlideUp {
            from { opacity: 0; transform: translateY(22px); }
            to { opacity: 1; transform: translateY(0); }
        }
        #hero .hero-fade { opacity: 0; animation: heroSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        #hero .hero-fade-1 { animation-delay: 0.12s; }
        #hero .hero-fade-2 { animation-delay: 0.24s; }
        #hero .hero-fade-3 { animation-delay: 0.36s; }
        #hero .hero-fade-4 { animation-delay: 0.48s; }
        #hero .hero-fade-5 { animation-delay: 0.60s; }

        @keyframes heroCarFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }
        #hero .hero-car-float {
            animation: heroCarFloat 4.8s ease-in-out infinite;
            filter: drop-shadow(0 35px 30px rgba(2, 6, 20, 0.45));
        }

        #hero .hero-cta {
            transition: transform .25s ease, box-shadow .25s ease, filter .25s ease;
        }
        #hero .hero-cta:hover {
            transform: translateY(-3px) scale(1.015);
            filter: brightness(1.06);
        }
        #hero .hero-trust-card {
            transition: transform .25s ease, border-color .25s ease, background-color .25s ease;
        }
        #hero .hero-trust-card:hover {
            transform: translateY(-2px);
            border-color: rgba(255, 255, 255, 0.35);
            background: rgba(255, 255, 255, 0.15);
        }
    </style>
</head>
